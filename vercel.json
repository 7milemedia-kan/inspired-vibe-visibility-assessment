{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix visibility-engine-assessment",
  "buildCommand": "npm run build",
  "outputDirectory": "visibility-engine-assessment/dist-vercel",
  "rewrites": [{ "source": "/admin", "destination": "/index.html" }, { "source": "/admin/", "destination": "/index.html" }],
  "headers": [
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] }
  ]
}
